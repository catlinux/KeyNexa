    <string name="cloud_sync_failed">Could not synchronise: %1$s</string>
    <string name="cloud_sync_unsupported">This service or bucket does not support the conditional writes synchronisation needs, so the switch stays off. Copies keep working. Some services, such as Backblaze B2, may not support them.</string>
    <string name="cloud_sync_error_auth">The service rejected the keys. Check them and try again.</string>
    <string name="cloud_sync_error_network">Could not connect. Check the network and try again.</string>
