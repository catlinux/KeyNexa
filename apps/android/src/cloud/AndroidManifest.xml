<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Only the cloud variant is allowed to reach the network; the offline variant must stay permission-free. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Only to hand an APK signed by the project to the system installer after the user pressed Install. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>
        <receiver
            android:name="io.github.catlinux.keynexa.app.updates.InstallResultReceiver"
            android:exported="false" />
    </application>
</manifest>
