    <string name="cloud_service_title">Choose the service</string>
    <string name="cloud_service_s3_title">S3 (Backblaze B2, Cloudflare R2, MinIO…)</string>
    <string name="cloud_service_s3_description">A storage service compatible with Amazon S3: you create a private bucket and an access key, and KeyNexa uploads your encrypted copies there. KeyNexa has no accounts and no servers of its own: the account is only with the storage service you choose.</string>
    <string name="cloud_needs_title">What you need</string>
    <string name="cloud_needs_step_number">%1$d. %2$s</string>
    <string name="cloud_needs_step_1">A free or paid account in an S3-compatible service.</string>
    <string name="cloud_needs_step_2">A private bucket (not public).</string>
    <string name="cloud_needs_step_3">An access key limited to that bucket, with read and write permission.</string>
    <string name="cloud_needs_step_4">Copy the endpoint, the region, the access key ID and the secret key.</string>
    <string name="cloud_needs_browser_note">The buttons open the provider’s website in your browser.</string>
