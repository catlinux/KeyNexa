    <string name="cloud_form_endpoint_help">For B2: https://s3.us-west-004.backblazeb2.com. For R2: https://&lt;account id&gt;.r2.cloudflarestorage.com.</string>
    <string name="cloud_form_region">Region</string>
    <string name="cloud_form_region_help">Filled in automatically for Backblaze, Amazon and Cloudflare; you can leave it empty there. Otherwise, type the region your service uses.</string>
