From 097bfa85479c4aa44ec60e2bdd0c3e02db8c5433 Mon Sep 17 00:00:00 2001
From: catlinux <marc.catlinux@gmail.com>
Date: Wed, 14 Oct 2026 01:09:52 +0200
Subject: [PATCH] Add KeePassDatabase.readHeader to inspect a file without
 deriving the key

Reuses the internal DatabaseHeader.readFrom and checks the KDBX signature, so a caller can show a file's
format or tell a complete file from a partial transfer cheaply.
---
 .../app/keemobile/kotpass/database/Decoder.kt     | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/kotpass/src/main/kotlin/app/keemobile/kotpass/database/Decoder.kt b/kotpass/src/main/kotlin/app/keemobile/kotpass/database/Decoder.kt
index 719d57c..8d29614 100644
--- a/kotpass/src/main/kotlin/app/keemobile/kotpass/database/Decoder.kt
+++ b/kotpass/src/main/kotlin/app/keemobile/kotpass/database/Decoder.kt
@@ -13,6 +13,7 @@ import app.keemobile.kotpass.database.header.DatabaseInnerHeader
 import app.keemobile.kotpass.database.header.Signature
 import app.keemobile.kotpass.errors.CryptoError
 import app.keemobile.kotpass.errors.FormatError
+import app.keemobile.kotpass.extensions.bufferStream
 import app.keemobile.kotpass.extensions.teeBufferStream
 import app.keemobile.kotpass.io.BufferedStream
 import app.keemobile.kotpass.models.XmlContext
@@ -205,3 +206,17 @@ private fun decryptRawContent(
             }
         }
 }
+
+/**
+ * Reads the unencrypted header only, without deriving the key, so a caller can inspect a file cheaply.
+ *
+ * @throws FormatError.UnknownFormat when the data does not start with the KDBX signature.
+ */
+fun KeePassDatabase.Companion.readHeader(inputStream: InputStream): DatabaseHeader {
+    val header = inputStream.source().bufferStream().use { DatabaseHeader.readFrom(it) }
+    val signature = header.signature
+    if (signature.base != Signature.Base || signature.secondary != Signature.Secondary) {
+        throw FormatError.UnknownFormat("File does not start with the KDBX signature.")
+    }
+    return header
+}
