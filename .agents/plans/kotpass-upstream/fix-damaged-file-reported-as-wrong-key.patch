From 34e33aa1e8b0e1b12a8e68d67714235d5e2064a6 Mon Sep 17 00:00:00 2001
From: catlinux <marc.catlinux@gmail.com>
Date: Wed, 14 Oct 2026 01:50:50 +0200
Subject: [PATCH] Fix two error cases when decoding

An AES-KDF seed of an invalid length was reported as CryptoError.InvalidKey (wrong key); it is a malformed
header and is now FormatError.InvalidHeader. In KDBX 3.x the stream-start-bytes check built an exception
(FormatError.InvalidContent) but never threw it, so a file whose first block did not decrypt as expected was
decoded anyway; it now throws CryptoError.InvalidKey as that check intends.
---
 .../kotpass/cryptography/format/AesKdf.kt     |  3 +-
 .../app/keemobile/kotpass/database/Decoder.kt |  2 +-
 .../kotpass/database/DecodeErrorsSpec.kt      | 32 +++++++++++++++++++
 3 files changed, 35 insertions(+), 2 deletions(-)
 create mode 100644 kotpass/src/test/kotlin/app/keemobile/kotpass/database/DecodeErrorsSpec.kt

diff --git a/kotpass/src/main/kotlin/app/keemobile/kotpass/cryptography/format/AesKdf.kt b/kotpass/src/main/kotlin/app/keemobile/kotpass/cryptography/format/AesKdf.kt
index a26bfcb..584545f 100644
--- a/kotpass/src/main/kotlin/app/keemobile/kotpass/cryptography/format/AesKdf.kt
+++ b/kotpass/src/main/kotlin/app/keemobile/kotpass/cryptography/format/AesKdf.kt
@@ -1,6 +1,7 @@
 package app.keemobile.kotpass.cryptography.format
 
 import app.keemobile.kotpass.errors.CryptoError
+import app.keemobile.kotpass.errors.FormatError
 import app.keemobile.kotpass.extensions.clear
 import app.keemobile.kotpass.extensions.sha256
 import java.security.GeneralSecurityException
@@ -30,7 +31,7 @@ internal object AesKdf {
             if (error is NoSuchAlgorithmException) {
                 throw CryptoError.AlgorithmUnavailable("AES/ECB encryption is not supported in current environment.")
             } else {
-                throw CryptoError.InvalidKey("Wrong KDF seed used for decryption.")
+                throw FormatError.InvalidHeader("KDF seed has an invalid length.")
             }
         } finally {
             bytes.clear()
diff --git a/kotpass/src/main/kotlin/app/keemobile/kotpass/database/Decoder.kt b/kotpass/src/main/kotlin/app/keemobile/kotpass/database/Decoder.kt
index 719d57c..50c3e3a 100644
--- a/kotpass/src/main/kotlin/app/keemobile/kotpass/database/Decoder.kt
+++ b/kotpass/src/main/kotlin/app/keemobile/kotpass/database/Decoder.kt
@@ -173,7 +173,7 @@ private fun decryptRawContent(
             )
             val streamStartBytes = header.streamStartBytes
             if (!streamStartBytes.rangeEquals(0, contentBlocks, 0, streamStartBytes.size)) {
-                FormatError.InvalidContent("Database content could be corrupted or cannot be decrypted.")
+                throw CryptoError.InvalidKey("Wrong key used for decryption.")
             }
 
             ContentBlocks.readContentBlocksVer3x(
diff --git a/kotpass/src/test/kotlin/app/keemobile/kotpass/database/DecodeErrorsSpec.kt b/kotpass/src/test/kotlin/app/keemobile/kotpass/database/DecodeErrorsSpec.kt
new file mode 100644
index 0000000..a05b404
--- /dev/null
+++ b/kotpass/src/test/kotlin/app/keemobile/kotpass/database/DecodeErrorsSpec.kt
@@ -0,0 +1,32 @@
+package app.keemobile.kotpass.database
+
+import app.keemobile.kotpass.cryptography.EncryptedValue
+import app.keemobile.kotpass.cryptography.format.AesKdf
+import app.keemobile.kotpass.errors.CryptoError
+import app.keemobile.kotpass.errors.FormatError
+import io.kotest.assertions.throwables.shouldThrow
+import io.kotest.core.spec.style.DescribeSpec
+
+class DecodeErrorsSpec : DescribeSpec({
+
+    describe("Decoding errors") {
+        it("Rejects a KDBX 3.x file opened with a wrong key") {
+            shouldThrow<CryptoError.InvalidKey> {
+                KeePassDatabase.decode(
+                    inputStream = ClassLoader.getSystemResourceAsStream("ver3_aes.kdbx")!!,
+                    credentials = Credentials.from(EncryptedValue.fromString("not the key"))
+                )
+            }
+        }
+
+        it("Reports a KDF seed of the wrong length as a header error, not as a wrong key") {
+            shouldThrow<FormatError.InvalidHeader> {
+                AesKdf.transformKey(
+                    key = ByteArray(32),
+                    seed = ByteArray(5),
+                    rounds = 1UL
+                )
+            }
+        }
+    }
+})
